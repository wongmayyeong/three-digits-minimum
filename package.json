{
  "name": "nebube",
  "version": "0.1.0",
  "private": true,
  "description": "NEBUBE: an evidence-first AI debate arena for NEAR investment theses. Judged on the evidence, not the conviction.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "db:local": "tsx scripts/local-postgres.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "research:refresh": "tsx research/refresh.ts",
    "research:rebuild": "tsx research/refresh.ts --offline",
    "voices:list": "tsx scripts/list-voices.ts",
    "research:bigquery": "tsx research/bigquery.ts",
    "debate:new": "tsx scripts/new-episode.ts",
    "refresh:now": "tsx scripts/refresh-now.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@google-cloud/bigquery": "^9.6.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "motion": "^14.10.1",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "prisma": "^7.10.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
