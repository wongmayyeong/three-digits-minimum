# Three Digits, Minimum? configuration. Copy to .env and fill in. Never commit .env.
# Names only; no real values belong in this file.

# ---------------------------------------------------------------- required
# PostgreSQL connection string (any managed Postgres, e.g. Supabase, Neon, RDS).
# Local development: `npm run db:local` starts an embedded server and prints this URL.
DATABASE_URL=

# Public base URL, used for canonical and Open Graph links.
THESIS_PUBLIC_URL=http://localhost:3000

# Salt for hashing client IPs in rate limits (raw IPs are never stored). Use a long random string.
CLIENT_HASH_SALT=

# ---------------------------------------------------------------- AI debates (required for new debates)
# Without one of these, the site works for browsing and replays, and "Start debate" is disabled.
# Option A: OpenAI Responses API (recommended).
OPENAI_API_KEY=
# Model id from https://developers.openai.com/api/docs/models (default gpt-6.1-sol).
OPENAI_MODEL=
# Reasoning effort: none|low|medium|high (default low; keeps turn latency down).
OPENAI_REASONING_EFFORT=
# Option B: any OpenAI-compatible Chat Completions endpoint with json_schema support (e.g. NEAR AI Cloud).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Price per 1M tokens for budget enforcement (set to your model's list price).
LLM_PRICE_INPUT_PER_M=2
LLM_PRICE_OUTPUT_PER_M=10

# ---------------------------------------------------------------- AI voices (optional)
# ElevenLabs text-to-speech with timestamps. Without it, debates play with captions or the
# viewer's browser voice. Pick three premade voices with `npm run voices:list`.
# Voices: ElevenLabs when its key and three voice IDs are set; otherwise OpenAI text-to-speech with OPENAI_API_KEY.
# TTS_PROVIDER=openai|elevenlabs|none forces a choice.
TTS_PROVIDER=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_BULL=
ELEVENLABS_VOICE_BEAR=
ELEVENLABS_VOICE_JUDGE=
# Default eleven_multilingual_v2.
ELEVENLABS_MODEL_ID=
# Defaults: 0.1 (ElevenLabs) or 0.012 (OpenAI).
TTS_PRICE_PER_1K_CHARS=

# ---------------------------------------------------------------- cost and abuse controls
DAILY_AI_BUDGET_USD=15
MAX_DEBATES_PER_DAY=60
RATE_LIMIT_DEBATES_PER_HOUR=4
LLM_MAX_OUTPUT_TOKENS=2500
LLM_MAX_OUTPUT_TOKENS_JUDGE=4000

# ---------------------------------------------------------------- data sources (optional)
# CoinGecko demo or pro key (higher rate limits).
COINGECKO_DEMO_API_KEY=
COINGECKO_PRO_API_KEY=
# NearBlocks API key (higher rate limits).
NEARBLOCKS_API_KEY=
# NEAR Intents Explorer partner JWT from https://partners.near-intents.org (integrator concentration).
INTENTS_EXPLORER_JWT=
# BigQuery (research CLI only): your project pays for bytes scanned.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
BIGQUERY_MAX_GB=25
BIGQUERY_DAYS=90

# ---------------------------------------------------------------- audio storage
# "db" (default): audio bytes in PostgreSQL. "s3": any S3-compatible bucket.
ASSET_STORAGE=db
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- worker
WORKER_CONCURRENCY=2
DB_POOL_MAX=10

# ---------------------------------------------------------------- local testing only
# Synthetic template "LLM" for exercising the pipeline without credentials. Refuses to run when
# NODE_ENV=production; its debates are labelled SYNTHETIC and hidden from the public library.
# THESIS_FIXTURE_LLM=1
